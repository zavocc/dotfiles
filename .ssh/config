# We use this so we don't need to use ssh-add before being cached in the agent
AddKeysToAgent yes
Host github.com gitlab.com
    User git
    IdentityFile ~/.ssh/github_id_rsa
    # Explicitly only use the specified identity file
    IdentitiesOnly yes
    # PubkeyAcceptedAlgorithms rsa-sha2-256 ssh-ed25519
